# Copy to .env before running docker compose.

# Hugging Face model repo used by TEI workers.
HF_MODEL_ID=phambatien/bge-m3-vi-vists-best-eval

# Public model name accepted by the gateway and exposed by TEI.
MODEL_NAME=bge-m3-vi-vists

# Optional Hugging Face token. Required only if HF_MODEL_ID is private.
# HF_TOKEN=

# Comma-separated bearer tokens accepted by the gateway.
# Replace this value before any shared or production deployment.
EMBEDDING_API_KEYS=change-me

# Gateway validation and protection.
MAX_INPUT_TOKENS=128
MAX_BODY_BYTES=131072
UPSTREAM_TIMEOUT_MS=300
RATE_LIMIT_RPM=6000
RATE_LIMIT_BURST=200

# TEI runtime tuning.
TEI_TOKENIZATION_WORKERS=8
TEI_MAX_CONCURRENT_REQUESTS=128
TEI_MAX_BATCH_TOKENS=8192
TEI_MAX_BATCH_REQUESTS=64
TEI_MAX_CLIENT_BATCH_SIZE=1
